# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/summit_platform
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/summit_platform?retryWrites=true&w=majority
MONGODB_URI=

# Secret key for signing Admin Panel session cookies (change in production!)
AUTH_SECRET=summit-platform-super-secret-change-me-2026

# Default Admin Credentials (used on initial database seed)
ADMIN_EMAIL=admin@summit.com
ADMIN_PASSWORD=Admin@123
